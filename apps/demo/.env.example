# PMXT API key (server-side only — never exposed to the browser). Get one at https://pmxt.dev/dashboard
PMXT_API_KEY=pmxt_live_your_key
# Base URL of the PMXT catalog API (market data)
PMXT_API_URL=https://api.pmxt.dev
# Base URL of the PMXT trading API (build/submit orders, balances, positions)
TRADING_API_URL=https://trade.pmxt.dev
